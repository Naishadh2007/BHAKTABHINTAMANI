# Correct MIME types — critical for module JS on strict browsers
<IfModule mod_mime.c>
  AddType application/javascript  .js .mjs
  AddType text/css                .css
  AddType image/svg+xml           .svg
  AddType font/woff2              .woff2
  AddType font/woff               .woff
  AddType application/json        .json
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve existing static files/directories directly — NO rewrite
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Route /api/* → Laravel (index.php bootstraps from public/)
  RewriteRule ^(api|public/api|test_db)(/.*)? index.php [L,QSA]

  # 3. React SPA — all other routes → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security
Options -Indexes

# GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 1 month"
</IfModule>
