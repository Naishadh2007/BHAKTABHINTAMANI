FROM php:8.4-cli

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    sqlite3 \
    libsqlite3-dev \
    zip \
    unzip \
    git \
    curl \
    libzip-dev

RUN docker-php-ext-install pdo_sqlite pdo_mysql mbstring zip

WORKDIR /app
COPY . /app

# Install PHP dependencies via Composer
RUN composer install --no-dev --optimize-autoloader

# Prepare SQLite Database and Storage permissions
RUN touch /app/database/database.sqlite
RUN chmod -R 777 /app/storage /app/bootstrap/cache /app/database

EXPOSE 8000

# Run migrations and seeders on container startup, then start server
CMD sh -c "php artisan migrate --force --seed && php artisan serve --host=0.0.0.0 --port=8000"
